# ---- 模型调度引擎（Phase 2，tech/model-scheduling/）----
# **非敏感的模型目录不在这里，在 backend/src/main/resources/ai-models.yml。**
# 那份文件登记 Provider、base-url、能力、等级、优先级、维度、批量上限与 rerank 文档上限，
# 但只写 secret-property 的**属性名**；密钥值一律由下面这些环境变量注入。
# 改配置需要重启应用才生效——catalog 是启动时构建的不可变快照，没有热更新。
#
# 每个 Provider 的密钥变量名要与 ai-models.yml 里该 Provider 的 secret-property 一致。
# 未注入的 Provider 会被标为 UNCONFIGURED 并在路由阶段过滤掉，应用照常启动。
#
# !! 真实密钥绝不写进仓库。CI 不注入任何一个，见 deploy/README.md「CI 不调用真实 Provider」。
DASHSCOPE_API_KEY=replace-me
# Phase 1 遗留凭据，仅维持既有 Embedding 回归。architecture.md §13 明确它不得扩展到
# Chat / 流式 Chat / Rerank，也不算已合规准入的 Provider。
EMBEDDING_API_KEY=replace-me

# 出站限流的主动节流（由 Provider 适配器执行，作用域是 Provider 实例）。
EMBEDDING_BATCH_INTERVAL=200ms
# 新建知识库默认绑定的向量身份，必须是 ai-models.yml 里某个 EMBEDDING deployment 的
# model-identity。已建知识库不受影响，改绑需要显式全量重建。
KNOWLEDGE_DEFAULT_EMBEDDING_IDENTITY=doubao-embedding-vision

# 诊断保留窗口。两个上限是"或"的关系，由保留任务每小时执行物理清理；
# 调度总览页把这两个值念给用户看，所以它们必须与实际清理行为一致。
AI_DIAGNOSTICS_RETENTION_MAX_AGE_DAYS=7
AI_DIAGNOSTICS_RETENTION_MAX_LOGICAL_CALLS=10000
AI_DIAGNOSTICS_RETENTION_ENABLED=true
AI_DIAGNOSTICS_RETENTION_INTERVAL=1h

# ---- 知识库模块（tech/knowledge-base/architecture.md）----

# 上传限制。max-swallow-size 容易漏：超限被拒后 Tomcat 默认仍会读完并丢弃整个请求体。
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=51MB
UPLOAD_MAX_SWALLOW_SIZE=2MB
# 长耗时操作限的是并发数而不是 QPS。
UPLOAD_MAX_CONCURRENT=3
UPLOAD_ACQUIRE_TIMEOUT=5s

# 异步入库与卡死回收。
KNOWLEDGE_INGESTION_ENABLED=true
KNOWLEDGE_INGESTION_POLL_INTERVAL=2s
KNOWLEDGE_INGESTION_HEARTBEAT_TIMEOUT=5m
KNOWLEDGE_INGESTION_RECOVERY_INTERVAL=60s

# 定时同步。min-interval 是唯一一处直接与钱挂钩的输入校验：它挡住 `* * * * * ?` 这类
# 每秒执行的表达式，那种表达式能在无人察觉时把 Embedding 费用打穿。
KNOWLEDGE_SYNC_ENABLED=true
KNOWLEDGE_SYNC_SCAN_INTERVAL=60s
KNOWLEDGE_SYNC_MIN_INTERVAL=10m
