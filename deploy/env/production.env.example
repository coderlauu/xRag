# ---- 知识库模块（tech/knowledge-base/architecture.md）----
# Embedding 供应商。base-url 是 /api/plan/v3 而非常见的 /api/v3——Plan 类 Key 打标准
# 路径直接 401，看着像笔误其实不是。doubao-embedding-vision 原生输出 2048 维，1024 靠
# 请求里的 dimensions 参数降维得到，该参数必须始终显式发送。
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# !! 真实密钥，绝不写进仓库。由部署环境注入，见 deploy/README.md「Embedding API Key」一节。
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_DIMENSIONS=1024
# 实测上限就是 10，传 32 条会被拒。
EMBEDDING_BATCH_SIZE=10

# 上传限制。max-swallow-size 容易漏：超限被拒后 Tomcat 默认仍会读完并丢弃整个请求体。
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=60MB
UPLOAD_MAX_SWALLOW_SIZE=2MB
# 长耗时操作限的是并发数而不是 QPS。
UPLOAD_MAX_CONCURRENT=3
UPLOAD_ACQUIRE_TIMEOUT=5s

# 异步入库与卡死回收。
KNOWLEDGE_INGESTION_ENABLED=true
KNOWLEDGE_INGESTION_POLL_INTERVAL=2s
KNOWLEDGE_INGESTION_HEARTBEAT_TIMEOUT=5m
KNOWLEDGE_INGESTION_RECOVERY_INTERVAL=60s

# 定时同步。min-interval 是唯一一处直接与钱挂钩的输入校验：它挡住 `* * * * * ?` 这类
# 每秒执行的表达式，那种表达式能在无人察觉时把 Embedding 费用打穿。
KNOWLEDGE_SYNC_ENABLED=true
KNOWLEDGE_SYNC_SCAN_INTERVAL=60s
KNOWLEDGE_SYNC_MIN_INTERVAL=10m
